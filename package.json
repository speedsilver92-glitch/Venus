{
  "name": "privora-messenger",
  "private": true,
  "version": "0.5.0",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace client\" \"wrangler dev\"",
    "build": "npm run build --workspace client",
    "test": "node --test server/src/*.test.js tests/free-cloudflare.test.js",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wrangler": "^4.125.0"
  },
  "type": "module"
}
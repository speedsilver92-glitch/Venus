{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "privora-messenger",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "PRIVORA_ROOM",
        "class_name": "PrivoraRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PrivoraContainer"]
    },
    {
      "tag": "v2-free",
      "deleted_classes": ["PrivoraContainer"],
      "new_sqlite_classes": ["PrivoraRoom"]
    }
  ]
}